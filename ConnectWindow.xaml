<Window x:Class="SpotifyBar.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Підключення Spotify" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        Background="{DynamicResource PopupBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Step" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Step}">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PillHoverBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="Підключення Spotify" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                   Text="Потрібно один раз: це дає віджету гучність Spotify і переходи на трек та артиста. Дані лишаються на вашому ПК."/>

        <TextBlock Style="{StaticResource Step}" Text="1. Відкрийте Spotify for Developers і натисніть «Create app»."/>
        <Button Style="{StaticResource Pill}" Content="Відкрити developer.spotify.com" HorizontalAlignment="Left"
                Margin="14,0,0,12" Click="OpenDashboard_Click"/>

        <TextBlock Style="{StaticResource Step}" Text="2. Назва та опис будь-які. У полі Redirect URI додайте цю адресу, а в «Which API/SDKs» оберіть Web API:"/>
        <DockPanel Margin="14,0,0,12">
            <Button Style="{StaticResource Pill}" Content="Копіювати" DockPanel.Dock="Right" Margin="8,0,0,0" Click="CopyRedirect_Click"/>
            <Border Background="{DynamicResource PillBrush}" CornerRadius="6" Padding="10,6">
                <TextBlock x:Name="RedirectText" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
            </Border>
        </DockPanel>

        <TextBlock Style="{StaticResource Step}" Text="3. Збережіть додаток, відкрийте Settings, скопіюйте Client ID і вставте сюди:"/>
        <Border Background="{DynamicResource PillBrush}" CornerRadius="6" Margin="14,0,0,14" Padding="2">
            <TextBox x:Name="ClientIdBox" Background="Transparent" BorderThickness="0" Padding="8,5"
                     Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12" TextChanged="ClientIdBox_TextChanged"/>
        </Border>

        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,0,0,12" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Pill}" Content="Скасувати" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="ConnectButton" Style="{StaticResource Pill}" Content="Увійти в Spotify" IsEnabled="False"
                    Background="#1DB954" Foreground="Black" FontWeight="SemiBold" Click="Connect_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
